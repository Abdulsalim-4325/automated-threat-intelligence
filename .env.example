# Application Settings
PROJECT_NAME="Automated Threat Intelligence & STIX 2.1 Engine"
ENVIRONMENT="development"
LOG_LEVEL="INFO"

# PostgreSQL 16 (Local Docker Compose defaults)
POSTGRES_USER="cti_user"
POSTGRES_PASSWORD="cti_local_password_2026"
POSTGRES_DB="stix_threat_db"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://cti_user:cti_local_password_2026@localhost:5432/stix_threat_db"

# Redis 7 (Broker & Cache-Aside Layer)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379/0"
CACHE_TTL_SECONDS=900

# OSINT Threat Feed API Keys
OTX_API_KEY="your_alienvault_otx_api_key_here"
ABUSEIPDB_API_KEY="your_abuseipdb_api_key_here"
THREATFOX_API_KEY="your_abuse_ch_auth_key_here"

# SOC Event-Driven Alerting
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_webhook_token"
CRITICAL_CONFIDENCE_THRESHOLD=85
